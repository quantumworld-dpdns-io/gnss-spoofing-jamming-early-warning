    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "analyze": "next build && npx @next/bundle-analyzer"
  },
  "dependencies": {
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "mapbox-gl": "^3.9.0",
    "deck.gl": "^9.1.0",
    "d3": "^7.9.0",
    "plotly.js-dist": "^2.35.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/d3": "^7.1.0",
    "tailwindcss": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "prettier": "^3.4.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.2.0",
    "vitest": "^3.0.0",
    "@playwright/test": "^1.50.0"
  }
}
