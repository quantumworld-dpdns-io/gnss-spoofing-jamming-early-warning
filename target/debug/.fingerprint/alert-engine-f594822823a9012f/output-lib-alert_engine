rive from `Super<Self>`.\n"},"level":"error","spans":[{"file_name":"src/detection-engine/crates/alert-engine/src/lib.rs","byte_start":952,"byte_end":985,"line_start":39,"line_end":39,"column_start":9,"column_end":42,"is_primary":true,"text":[{"text":"        self.dispatchers.push(dispatcher);","highlight_start":9,"highlight_end":42}],"label":"`dispatcher::AlertDispatcher` is not dyn compatible","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[{"message":"for a trait to be dyn compatible it needs to allow building a vtable\nfor more information, visit <https://doc.rust-lang.org/reference/items/traits.html#dyn-compatibility>","code":null,"level":"note","spans":[{"file_name":"src/detection-engine/crates/alert-engine/src/dispatcher.rs","byte_start":96,"byte_end":111,"line_start":5,"line_end":5,"column_start":11,"column_end":26,"is_primary":false,"text":[{"text":"pub trait AlertDispatcher: Send + Sync {","highlight_start":11,"highlight_end":26}],"label":"this trait is not dyn compatible...","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"src/detection-engine/crates/alert-engine/src/dispatcher.rs","byte_start":140,"byte_end":148,"line_start":6,"line_end":6,"column_start":14,"column_end":22,"is_primary":true,"text":[{"text":"    async fn dispatch(&self, alert: &Alert) -> Result<(), AlertError>;","highlight_start":14,"highlight_end":22}],"label":"...because method `dispatch` is `async`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[],"rendered":null},{"message":"consider moving `dispatch` to another trait","code":null,"level":"help","spans":[],"children":[],"rendered":null},{"message":"the following types implement `dispatcher::AlertDispatcher`:\n  dispatcher::ConsoleDispatcher\n  dispatcher::WebhookDispatcher\n  dispatcher::EmailDispatcher\nconsider defining an enum where each variant holds one of these types,\nimplementing `dispatcher::Aler