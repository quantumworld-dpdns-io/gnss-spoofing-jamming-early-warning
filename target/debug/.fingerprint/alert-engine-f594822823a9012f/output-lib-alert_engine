rive from `Super<Self>`.\n"},"level":"error","spans":[{"file_name":"src/detection-engine/crates/alert-engine/src/lib.rs","byte_start":1742,"byte_end":1759,"line_start":61,"line_end":61,"column_start":31,"column_end":48,"is_primary":true,"text":[{"text":"            for dispatcher in &self.dispatchers {","highlight_start":31,"highlight_end":48}],"label":"`dispatcher::AlertDispatcher` is not dyn compatible","suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"src/detection-engine/crates/alert-engine/src/lib.rs","byte_start":1724,"byte_end":1923,"line_start":61,"line_end":65,"column_start":13,"column_end":14,"is_primary":false,"text":[{"text":"            for dispatcher in &self.dispatchers {","highlight_start":13,"highlight_end":50},{"text":"                if let Err(e) = dispatcher.dispatch(alert).await {","highlight_start":1,"highlight_end":67},{"text":"                    tracing::error!(\"dispatch failed: {}\", e);","highlight_start":1,"highlight_end":63},{"text":"                }","highlight_start":1,"highlight_end":18},{"text":"            }","highlight_start":1,"highlight_end":14}],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":null},"macro_decl_name":"desugaring of `for` loop","def_site_span":{"file_name":"src/detection-engine/crates/alert-engine/src/lib.rs","byte_start":0,"byte_end":0,"line_start":1,"line_end":1,"column_start":1,"column_end":1,"is_primary":false,"text":[],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":null}}}],"children":[{"message":"for a trait to be dyn compatible it needs to allow building a vtable\nfor more information, visit <https://doc.rust-lang.org/reference/items/traits.html#dyn-compatibility>","code":null,"level":"note","spans":[{"file_name":"src/detection-engine/crates/alert-engine/src/dispatcher.rs","byte_start":96,"byte_end":111,"line_start":5,"line_end":5,"column_start":11,"column_end":26,"is_primary":false,"