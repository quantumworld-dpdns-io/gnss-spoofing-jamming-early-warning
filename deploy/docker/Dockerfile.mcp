FROM rust:1.85-slim-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src/detection-engine/crates/ ./src/detection-engine/crates/
COPY src/mcp-server/ ./src/mcp-server/
RUN cargo build --release -p mcp-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/mcp-server /usr/local/bin/
EXPOSE 8090
ENTRYPOINT ["mcp-server"]
CMD ["--host", "0.0.0.0:8090"]
