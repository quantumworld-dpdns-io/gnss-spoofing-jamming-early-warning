#!/bin/bash
set -e

case "$1" in
    configure)
        echo "Configuring gnss-detection..."
        if command -v systemctl &> /dev/null; then
            systemctl daemon-reload
            systemctl enable gnss-detection-mcp.service
            systemctl enable gnss-detection-api.service
            echo "Services enabled."
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        exit 0
        ;;
    *)
        echo "postinst called with unknown argument '$1'"
        exit 1
        ;;
esac

exit 0
