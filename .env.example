# ─── General ───────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8080
MCP_PORT=8090

# ─── API Gateway ───────────────────────────────────────────
RATE_LIMIT=100
RATE_LIMIT_WINDOW_SECS=60
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24
ALLOWED_ORIGINS=*

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=duckdb:///data/gnss.duckdb
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE=/data/iceberg

# ─── Vector DB ─────────────────────────────────────────────
LANCE_DB_URI=/data/lancedb
VECTOR_DIMENSION=384

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── MCP Server ────────────────────────────────────────────
MCP_TRANSPORT=stdio
MCP_PROTOCOL_VERSION=2025-03-26

# ─── Quantum Computing ──────────────────────────────────────
QUANTUM_BACKEND=aer
QUANTUM_SHOTS=1024
QUANTUM_CIRCUIT_DEPTH=4
QUANTUM_USE_GPU=false
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=ibm-q/open/main

# ─── CUDA-Q ─────────────────────────────────────────────────
CUDA_Q_SIMULATOR=default
CUDA_Q_TARGET=nvidia

# ─── Security ──────────────────────────────────────────────
POST_QUANTUM_KEM=ml-kem-768
POST_QUANTUM_SIG=ml-dsa-65
TLS_CERT_PATH=
TLS_KEY_PATH=
PQC_LIBOQS_PATH=/usr/local/lib/liboqs.so

# ─── Observability ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=gnss-detection
WANDB_ENTITY=
WANDB_PROJECT=gnss-spoofing-detection

# ─── Robot Framework ───────────────────────────────────────
ROBOT_BROWSER=headlesschrome
ROBOT_API_URL=http://localhost:8080
ROBOT_MCP_URL=http://localhost:8090

# ─── Notifications ──────────────────────────────────────────
SLACK_WEBHOOK_URL=
EMAIL_SMTP_SERVER=smtp.example.com:587
EMAIL_FROM=alerts@gnss-detection.local
ALERT_RECIPIENTS=admin@example.com

# ─── Agent Integrations ─────────────────────────────────────
HERMES_AGENT_ENABLED=false
LANGGRAPH_API_URL=http://localhost:8123
CREWAI_ENABLED=false

# ─── Performance ────────────────────────────────────────────
MAX_OBSERVATIONS_PER_REQUEST=10000
DETECTION_TIMEOUT_MS=5000
WORKER_THREADS=4
